# Copie para .env e preencha. NUNCA faça commit do .env.
# Crie a API key na Binance com permissão SOMENTE de "Spot Trading".
# NÃO habilite saque (withdraw). Restrinja por IP se possível.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Para o modo live operar com dinheiro real, este valor precisa ser exatamente SIM
CONFIRMO_OPERAR_DINHEIRO_REAL=NAO

# ---- Avisos no celular (opcional) ----
# 1) No Telegram, fale com @BotFather -> /newbot -> copie o token
TELEGRAM_BOT_TOKEN=
# 2) Mande qualquer mensagem para o seu bot e abra no navegador:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  -> copie "chat":{"id": ...}
TELEGRAM_CHAT_ID=
# 3) Alerta de bot PARADO: crie um check grátis em https://healthchecks.io
#    (Period 5 min, Grace 10 min), ligue a integração do Telegram lá e cole a URL de ping:
HEALTHCHECK_URL=
