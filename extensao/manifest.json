{
  "manifest_version": 3,
  "name": "Leitor de Pedidos - Protocolo Sarapuí",
  "version": "0.2.0",
  "description": "Lê o pedido de compra dentro do protocolo e envia para o sistema de acompanhamento de entregas.",
  "permissions": ["storage", "offscreen"],
  "host_permissions": [
    "https://sarapuiweb.jlsoft.com.br/*",
    "https://jlsoftdocto.s3.sa-east-1.amazonaws.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://sarapuiweb.jlsoft.com.br/protocolo/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "Leitor de Pedidos", "default_popup": "options.html" }
}
